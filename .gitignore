# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment Variables (Catches it anywhere)
.env
**/.env
.env.local
.env.*
# Excludes your template from being ignored
!.env.example

# Vector Database (This is inside your nested folder)
**/chroma_db/
# Local Document Store
**/docstore/

# Node/React (Very important for your frontend)
node_modules/
**/node_modules/
.next/

# Mac system files
.DS_Store

# Frontend specifics
frontend/.env.local

# Troubleshooting scripts
test_conn.py
add_test.py
debug_splitter.py
test_docstore.py
test_search.py
test_waqi.py
test_weather_hitl.py

# Renamed-aside index directories.
# **/chroma_db/ above does NOT match chroma_db.bak/, so without this a
# `git add .` stages hundreds of megabytes of superseded index.
*.bak/
**/*.bak/

# Agents
.agents/
scratch/

# Miscellaneous
miscellaneous/

# Local logs
latest_run_logs.txt