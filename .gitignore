# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment Variables (Catches it anywhere)
.env
**/.env
.env.local
.env.*
# Excludes your template from being ignored
!.env.example

# Vector Database (This is inside your nested folder)
**/chroma_db/
# Local Document Store
**/docstore/

# LLM response cache. Regenerated on demand, and it grows on every eval run.
# It was tracked once, reached 56.7 MB, and HuggingFace refused every push
# until it was removed from the history. Do not track it again.
.langchain.db
**/.langchain.db

# Node/React (Very important for your frontend)
node_modules/
**/node_modules/
.next/

# Mac system files
.DS_Store

# Frontend specifics
frontend/.env.local

# Troubleshooting scripts
test_conn.py
add_test.py
debug_splitter.py
test_docstore.py
test_search.py
test_waqi.py
test_weather_hitl.py

# Renamed-aside index directories.
# **/chroma_db/ above does NOT match chroma_db.bak/, so without this a
# `git add .` stages hundreds of megabytes of superseded index.
*.bak/
**/*.bak/

# Agents
.agents/
scratch/

# Miscellaneous
miscellaneous/

# Local logs
latest_run_logs.txt

# Ingestion manifest. Tracked once, which was the bug: the Dockerfile copies
# data/, so the Space received a manifest naming all 26 files while
# .gitignore:21 and :23 kept the index itself out of the repository.
# initialize_rag then took the early return at ingest.py:91-93 and served an
# empty vector database. Untracked, the Space has no manifest,
# ingest.py:32 returns an empty one, and the container ingests at startup in
# the background thread at app.py:76. The local copy is untouched, so local
# Docker builds still use the existing index.
data/.manifest.json

# Claude Code local permissions. Untracked on purpose: the file holds absolute
# paths containing the username, and this repository is public. .claude/ is
# only partially tracked — .claude/skills/close-out/SKILL.md is committed — so
# this names the one file, not the directory.
.claude/settings.local.json
