# .env.example

# LLM Provider API Keys
OPENAI_API_KEY="your_openai_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/your_db_name"

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="your_langchain_api_key_here"
LANGCHAIN_PROJECT="your_langchain_project"

WAQI_API_KEY=your_copied_token_here

# Feature switches. Unset or empty means on. Only "false" turns a feature off.
# Each change needs a restart. See DECISIONS.md, "Three env switches".
# FAST_PATH_ENABLED=
# TRANSCRIPT_REFINE_ENABLED=
# WEATHER_TOOL_ENABLED=